# Production .env for MASAR. Copy to /var/www/masar/.env and fill the blanks.
# No secret belongs in this file in the repository: every credential below is
# empty on purpose. deploy.sh refuses to run with APP_DEBUG anything but false.

APP_NAME=MASAR
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://masar.sa
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Asia/Riyadh

# Behind Cloudflare: the proxy ranges, or * if nothing reaches the box but the proxy.
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masar
DB_USERNAME=masar
DB_PASSWORD=

# Redis is required: cache tags.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Media never lives on the app server.
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MASAR

# Editions: all six public (owner's ruling, 2026-10-29).
MASAR_LOCALES_ENABLED=ar,en,fr,hi,ur-pk,zh-hans

# Translation: no outside service (owner's ruling). Keep these as they are.
MASAR_TRANSLATION_DRIVER=null
MASAR_TRANSLATION_ALLOW_EXTERNAL=false
MASAR_TRANSLATION_AUTO_ON_PUBLISH=false
MASAR_TRANSLATION_AUTO_RETRANSLATE=false
